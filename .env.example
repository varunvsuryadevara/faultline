# FaultLine server settings.
# Copy this file to .env (same folder) and fill in your key.
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env
#
# The key is read only by the Node server (server/index.js). It is never sent to the browser.
# Never rename these variables with a VITE_ prefix: Vite would bundle them into the page.
# The server re-reads this file whenever you save it, so no restart is needed (except for PORT and HOST).

# Which model provider to use: "anthropic" (default) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=anthropic

# --- Claude (Anthropic) ---------------------------------------------------------------------
# Create a key in the Claude Console: https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 is the default. claude-haiku-5-5 is faster and cheaper; claude-opus-5-5 is stronger.
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high. Lower is faster; medium is a good balance for a live demo.
ANTHROPIC_EFFORT=medium
# Stream the model's summarised reasoning into the live progress log (true | false).
ANTHROPIC_SHOW_REASONING=true

# --- Any OpenAI-compatible API (set LLM_PROVIDER=openai) -------------------------------------
# OpenAI:      OPENAI_BASE_URL=https://api.openai.com/v1                              OPENAI_MODEL=gpt-5.4-mini
# Gemini:      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  OPENAI_MODEL=gemini-3.8-flash
# Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1                         OPENAI_MODEL=<a Groq model id>
# Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1                              OPENAI_MODEL=<a local model>  (no key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- Server -----------------------------------------------------------------------------------
PORT=8787
# 127.0.0.1 keeps the server private to this computer. Use 0.0.0.0 when deploying or demoing over a network.
HOST=127.0.0.1
# Analyses allowed per client per 10 minutes (protects your key if you expose the server).
RATE_LIMIT_PER_10_MIN=30
# Give up on a model call after this many seconds.
ANALYSIS_TIMEOUT_SECONDS=240
